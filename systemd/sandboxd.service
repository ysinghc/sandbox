[Unit]
Description=Sandbox Engine Daemon
After=network.target sandbox-privileged.service
Requires=sandbox-privileged.service
BindsTo=sandbox-privileged.service

[Service]
Type=notify
ExecStart=/usr/local/bin/sandboxd
ExecStartPre=-/usr/local/bin/sandboxd --validate-config
Restart=on-failure
RestartSec=5s
WatchdogSec=30s
StandardError=journal

# #9: the daemon is unprivileged. All taps, nftables rules, jails, cgroups,
# and VMM processes are owned by sandbox-privileged (same lifecycle via the
# mutual BindsTo); the daemon talks to it over the packaged socket, which an
# unprivileged daemon uses by default. Root execution stays supported for
# development: without privileged_socket configured, a root daemon spawns
# in-process exactly as before.
User=sandboxd
Group=sandboxd
NoNewPrivileges=true

# Runtime sockets (engine.sock, broker-control.sock).
RuntimeDirectory=sandbox-engine
RuntimeDirectoryMode=0755

PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Workspaces/volumes/scratch live here, as do the jails the daemon binds its
# per-VM sockets into (0770 group access) and the snapshot store it reads.
ReadWritePaths=/var/lib/sandbox-engine /var/run/sandbox-engine

# Resource limits (Phase 11). The pool holds a bounded number of VMs; give the
# daemon room for pool threads, uffd threads and client fds.
LimitNOFILE=65536
TasksMax=512

[Install]
WantedBy=multi-user.target
